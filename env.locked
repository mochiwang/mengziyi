# 锁定的环境配置 - 重构前备份
# 创建时间: 2025-01-20
# 用途: 确保重构过程中环境一致性

# ===== 服务器配置 =====
PORT=5001
APP_ENV=development
SECRET_KEY=change-me
ENABLE_CORS=1
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ===== 功能开关 =====
CLASSROOM_MODE_ENABLED=0

# ===== 依赖版本锁定 =====
# Python依赖 (requirements.txt)
FLASK_VERSION=2.3.3
WERKZEUG_VERSION=2.3.7
OPENAI_WHISPER_VERSION=20231117

# ===== 路径配置 =====
# 数据目录
DATA_DIR=menziyi-server/data
LESSONS_DIR=menziyi-server/data/lessons
DB_PATH=menziyi-server/db/index.sqlite

# 笔记处理目录
NOTES_DIR=notes
PROMPTS_DIR=prompts
TOOLS_DIR=tools

# ===== 音频处理配置 =====
# Whisper模型配置
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=true

# 音频格式配置
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=1
AUDIO_FORMAT=MPEG4AAC
AUDIO_QUALITY=high

# ===== 网络配置 =====
# API端点
API_BASE_URL=http://localhost:5001
API_HEALTH_ENDPOINT=/healthz
API_UPLOAD_ENDPOINT=/api/lessons/upload

# ===== 证书和密钥路径 =====
# 注意: 生产环境需要配置真实的证书路径
SSL_CERT_PATH=
SSL_KEY_PATH=
API_KEY_PATH=

# ===== 监控和日志 =====
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# ===== 性能配置 =====
MAX_UPLOAD_SIZE=100MB
MAX_CONCURRENT_UPLOADS=5
TRANSCODE_TIMEOUT=300

# ===== 安全配置 =====
CORS_ORIGINS=*
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ===== 备份配置 =====
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7
